{
  "name": "Architecture Health Monitor",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1440,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily autonomous trigger that checks architecture health. When health < 100 or capabilities < 100, sets the self-healing swarm into motion: retry \u2192 flag \u2192 audit agent \u2192 repair agent \u2192 validate. Throttled from 10-min to daily to prevent wasteful duplicate flag escalation on unbuilt features.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "architecture_health_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_healing_loop": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runSelfHealingLoop",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run Self-Healing Loop",
            "description": "Check architecture health and capabilities. If < 100, retry failed goals, flag issues, audit root cause, repair, and validate \u2014 autonomously."
          }
        }
      }
    ]
  }
}