{
  "name": "Governance Heartbeat",
  "description": "Canonical 5-minute AutoComplete heartbeat. All system-hardening clocks converge on the leased orchestrator so overlapping schedulers cannot independently repair or score the platform.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "governance_heartbeat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_autocomplete_continuous": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAutoCompleteContinuousCycle",
            "args": {
              "trigger": "governance_5m"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run canonical AutoComplete cycle",
            "description": "Single leased 5-minute audit, validation, repair-queue, scoring and bounded-healing orchestrator"
          }
        }
      }
    ]
  }
}